[PARAMETERS]
//#isInt? #name   #dist.#min  #max 
//all Ns are in number of haploid individuals
1  Spain     logunif     100  1000000   output
1  France     logunif     100  1000000   output
1  UK     logunif     100  1000000   output
1  Tdiv2         unif     10   10000     output
1  Tplus         unif     10  10000     hide
0  RESIZE       unif     0.1  10     hide

[COMPLEX PARAMETERS]
//Assume an island haploid population size of 1000 for all islands
1 Tdiv1 = Tdiv2+Tplus output
1 AncSize = RESIZE*Spain
